run = "streamlit run main.py --server.address 0.0.0.0 --server.port 8501 --server.headless true"

modules = ["python-base-3.13"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "c-ares", "cacert", "cairo", "cargo", "chromedriver", "dos2unix", "ffmpeg-full", "freefont_ttf", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "grpc", "gtk3", "lcms2", "libcxx", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "ocl-icd", "opencl-headers", "openjpeg", "openssl", "pkg-config", "qhull", "rdkafka", "rustc", "tcl", "tk", "xdg-utils", "xsimd", "zlib"]

[[ports]]
localPort = 8501
externalPort = 80
